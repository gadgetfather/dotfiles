# ---------------------------------------------------------------------------
# ghost-complete — terminal-native autocomplete.
# Must stay at the top: the managed block exec's a PTY proxy, replacing this
# shell, so anything above it runs twice.
# ---------------------------------------------------------------------------
# >>> ghost-complete initialize >>>
# !! Contents within this block are managed by 'ghost-complete install' !!
if [[ -f "$HOME/.config/ghost-complete/shell/init.zsh" ]]; then
  builtin source "$HOME/.config/ghost-complete/shell/init.zsh"
fi
# <<< ghost-complete initialize <<<

# herdr spawns its pane shells itself, so they carry no TERM_PROGRAM and the
# managed block above sees an unknown terminal and skips the proxy. Start it
# here instead. Requires `[experimental] multi_terminal = true` in
# ~/.config/ghost-complete/config.toml, or the binary refuses to launch.
if [[ ( -n "$HERDR_PANE_ID" || "$HERDR_ENV" == "1" ) && -z "$GHOST_COMPLETE_ACTIVE" ]] \
   && command -v ghost-complete >/dev/null 2>&1; then
  export GHOST_COMPLETE_ACTIVE=1
  exec ghost-complete
fi

# --- runtimes --------------------------------------------------------------
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"          # uv

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# --- google cloud sdk (homebrew build) -------------------------------------
[ -f '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc' ] \
  && . '/opt/homebrew/share/google-cloud-sdk/path.zsh.inc'
[ -f '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc' ] \
  && . '/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc'
[ -f "$HOME/.config/gcloud/application_default_credentials.json" ] \
  && export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/gcloud/application_default_credentials.json"

# --- herdr helpers: hd / hdc / hdl, plus fzf key bindings -------------------
[ -r "$HOME/.config/herdr/shell.zsh" ] && source "$HOME/.config/herdr/shell.zsh"

# --- machine-local: corp CA bundles, managed-tool blocks, anything secret ---
# Installers (Kiro, endpoint security, VPN clients) append to ~/.zshrc; point
# them here instead so this file stays portable.
[ -r "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# ghost-complete 0.19 also wants this second block, sourced late. `ghost-complete
# install` writes it with an absolute path AND replaces this file with a regular
# one, breaking the dotfiles symlink -- so re-link after ever running it.
# $HOME is used here to keep the file portable. Trade-off: `ghost-complete
# doctor` reads this path as a literal string without expanding it, so it
# reports the init script missing. That warning is a false negative; zsh
# expands $HOME correctly at source time and the integration works.
# >>> ghost-complete shell integration >>>
# !! Contents within this block are managed by 'ghost-complete install' !!
source "$HOME/.config/ghost-complete/shell/ghost-complete.zsh"
# <<< ghost-complete shell integration <<<
